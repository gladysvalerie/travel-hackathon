{
  "name": "TripLedger – Travel Booking & Budget Manager",
  "description": "Save your flight bookings from any website and sync them to your travel budget.",
  "version": "0.1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/trip_ledger_icon.png",
      "48": "assets/trip_ledger_icon.png",
      "128": "assets/trip_ledger_icon.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["tabs", "activeTab", "scripting", "storage", "windows"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "assets/trip_ledger_icon.png",
    "48": "assets/trip_ledger_icon.png",
    "128": "assets/trip_ledger_icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/contentScript.js"]
    }
  ]
}
