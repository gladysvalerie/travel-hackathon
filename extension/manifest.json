{
    "name": "TripLedger – Travel Booking & Budget Manager",
    "description": "Save your flight bookings from any website and sync them to your travel budget.",
    "version": "0.1.0",
    "manifest_version": 3,
    "action": {
      "default_popup": "ui/popup.html",
      "default_icon": {
        "16": "assets/icon16.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
      }
    },
    "background": {
      "service_worker": "ui/background.js",
      "type": "module"
    },
    "permissions": ["tabs", "activeTab", "scripting", "storage", "windows"],
    "host_permissions": ["<all_urls>"],
    "icons": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["ui/contentScript.js"]
      }
    ]
  }